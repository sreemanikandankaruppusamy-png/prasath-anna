# ====================================================================
# SRI BALU ELECTRONICS & FURNITURES - ENVIRONMENT CONFIGURATION
# ====================================================================

# Port for local server (defaults to 3000)
PORT=3000

# Admin API Secret Token (Used to secure write and admin read operations)
API_SECRET_TOKEN=admin-secret-token

# ====================================================================
# DATABASE OPTIONS
# ====================================================================

# OPTION 1: Local Embedded JSON / SQLite Storage (Default - ZERO SETUP)
# No configuration needed! All products and orders are automatically
# persisted to data/store.json on the server disk.
# DB_TYPE=local

# OPTION 2: Supabase (Cloud PostgreSQL)
# 1. Sign up at https://supabase.com (Free)
# 2. Create a new project and go to Settings > Database
# 3. Paste the Connection String URI below:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OPTION 3: MongoDB Atlas (Cloud NoSQL)
# 1. Create a free cluster at https://mongodb.com/atlas
# 2. Get your connection string URI and paste below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sri_balu_store?retryWrites=true&w=majority

# OPTION 4: Upstash Redis / Vercel KV (Fast Key-Value Storage)
# 1. From Vercel dashboard > Storage or https://console.upstash.com
# 2. Set KV_URL:
# KV_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
